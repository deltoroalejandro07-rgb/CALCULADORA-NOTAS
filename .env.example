# Copia este fichero a .env.local y rellénalo.
# En local, `npx supabase start` imprime estos valores (API_URL y PUBLISHABLE_KEY / ANON_KEY).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Solo servidor (nunca con prefijo NEXT_PUBLIC_). Se usa para invitar usuarios e importar.
SUPABASE_SECRET_KEY=
